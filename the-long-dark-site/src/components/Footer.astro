---

<footer class="border-t border-slate-700 bg-slate-800/50 mt-16">
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-lg font-semibold text-slate-100 mb-4">The Long Dark</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          A thoughtful, first-person survival simulation that emphasizes quiet exploration in a stark, yet hauntingly beautiful post-disaster setting.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold text-slate-100 mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/encyclopedia/regions" class="text-slate-400 hover:text-white transition-colors">Regions</a>
          </li>
          <li>
            <a href="/encyclopedia/wildlife" class="text-slate-400 hover:text-white transition-colors">Wildlife</a>
          </li>
          <li>
            <a href="/encyclopedia/items" class="text-slate-400 hover:text-white transition-colors">Items</a>
          </li>
          <li>
            <a href="/story-mode" class="text-slate-400 hover:text-white transition-colors">Story Mode</a>
          </li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-lg font-semibold text-slate-100 mb-4">Resources</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://thelongdark.fandom.com/wiki/The_Long_Dark_Wiki" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">
              Official Wiki
            </a>
          </li>
          <li>
            <a href="https://www.hinterlandgames.com/" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">
              Hinterland Games
            </a>
          </li>
          <li>
            <a href="https://store.steampowered.com/app/305620/The_Long_Dark/" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">
              Steam Store
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-700 mt-8 pt-8 text-center text-sm text-slate-500">
      <p>&copy; {new Date().getFullYear()} The Long Dark Fan Site. This is a fan-made site and is not affiliated with Hinterland Games.</p>
      <p class="mt-2">The Long Dark® is a registered trademark of Hinterland Games.</p>
    </div>
  </div>
</footer>
